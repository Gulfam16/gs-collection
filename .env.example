# GS Collection Environment Variables
# NEVER commit real production credentials to Git.

# PostgreSQL Connection String (Supabase / Neon)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets
NEXTAUTH_SECRET="gs-collection-super-secret-jwt-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Media Storage (Free Tier)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Store Currency Default
NEXT_PUBLIC_STORE_CURRENCY="PKR"
NEXT_PUBLIC_SHIPPING_FLAT_RATE="250"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="3000"
